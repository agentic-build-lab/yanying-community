METAHUMAN_BIND_HOST=127.0.0.1
METAHUMAN_OUTPUT_ROOT=.runtime/outputs
METAHUMAN_ENABLE_LEGACY_ADAPTER=0
METAHUMAN_TTS_PROVIDER=edge_neural
METAHUMAN_TTS_EDGE_VOICE=zh-CN-YunjianNeural

# Optional real-rendering dependencies
METAHUMAN_DEFAULT_AVATAR_IMAGE=C:\path\to\presenter.png
METAHUMAN_WAV2LIP_REPO=C:\path\to\Wav2Lip
METAHUMAN_WAV2LIP_CHECKPOINT=C:\path\to\wav2lip_gan.pth
METAHUMAN_MUSETALK_REPO=C:\path\to\MuseTalk
